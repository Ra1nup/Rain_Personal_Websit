---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const sorted = allProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
  
  return sorted.map((project, index) => {
    const prevProject = index > 0 ? sorted[index - 1] : null;
    const nextProject = index < sorted.length - 1 ? sorted[index + 1] : null;
    return {
      params: { slug: project.slug || project.id },
      props: { project, prevProject, nextProject },
    };
  });
}

interface Props {
  project: CollectionEntry<"projects">;
  prevProject: CollectionEntry<"projects"> | null;
  nextProject: CollectionEntry<"projects"> | null;
}

const { project, prevProject, nextProject } = Astro.props;
const {
  title,
  tagline,
  category,
  tags,
  role,
  year,
  status,
  coverImage,
  demoUrl,
  githubUrl,
} = project.data;

// Category label mapping (matching filter tabs)
const categoryLabels: Record<string, string> = {
  Web: "Web Dev",
  AIGC: "AIGC & AI",
  Tools: "Tools",
  Mobile: "Mobile Apps",
};

const displayCategory = categoryLabels[category] || category;

// Render Markdown Content Body
const { Content } = await render(project);

const prevSlug = prevProject ? (prevProject.slug || prevProject.id) : null;
const nextSlug = nextProject ? (nextProject.slug || nextProject.id) : null;
---

<BaseLayout 
  title={`${title} - Portfolio | Rainup`}
  description={tagline}
>
  <article class="project-detail-page container">
    <!-- Top Breadcrumb Navigation -->
    <div class="top-nav fade-in">
      <a href="/portfolio" class="back-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>返回作品集</span>
      </a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">{title}</span>
    </div>

    <!-- Project Hero Header -->
    <header class="detail-hero fade-in" style="animation-delay: 0.1s;">
      <div class="meta-pills">
        <span class="category-badge">{displayCategory}</span>
        <span class={`status-badge ${status.toLowerCase().replace(' ', '-')}`}>
          <span class="status-dot"></span>
          {status}
        </span>
      </div>

      <h1 class="project-title">{title}</h1>
      <p class="project-tagline">{tagline}</p>

      <!-- Action Links -->
      <div class="hero-actions">
        {demoUrl && (
          <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span>在线体验 / 访问</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        )}
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub 源码</span>
          </a>
        )}
      </div>

      <!-- Quick Info Bar -->
      <div class="info-bar glass">
        <div class="info-item">
          <span class="info-label">担任角色</span>
          <span class="info-value">{role}</span>
        </div>
        <div class="info-item">
          <span class="info-label">开发周期</span>
          <span class="info-value">{year}</span>
        </div>
        <div class="info-item">
          <span class="info-label">项目分类</span>
          <span class="info-value">{displayCategory}</span>
        </div>
      </div>
    </header>

    <!-- Cover Image Showcase -->
    {coverImage && (
      <div class="cover-showcase-box fade-in" style="animation-delay: 0.15s;">
        <Image
          src={coverImage}
          alt={title}
          width={1200}
          height={675}
          quality="max"
          class="detail-cover-img"
        />
      </div>
    )}

    <!-- Tech Stack Pill Wall -->
    <div class="tech-section glass fade-in" style="animation-delay: 0.2s;">
      <span class="tech-section-label">🛠️ 技术栈与选型：</span>
      <div class="tech-pills">
        {tags.map((tag) => (
          <span class="tech-pill">{tag}</span>
        ))}
      </div>
    </div>

    <!-- Markdown Rich Content Body -->
    <main class="project-prose prose fade-in" style="animation-delay: 0.25s;">
      <Content />
    </main>

    <!-- Bottom Prev / Next Navigation -->
    <nav class="project-navigation fade-in" style="animation-delay: 0.3s;" aria-label="Projects Navigation">
      {prevProject ? (
        <a href={`/portfolio/${prevSlug}`} class="nav-card prev glass">
          <span class="nav-hint">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            上一项目
          </span>
          <span class="nav-title">{prevProject.data.title}</span>
        </a>
      ) : (
        <div class="nav-placeholder"></div>
      )}

      <a href="/portfolio" class="nav-all-btn glass" title="返回项目列表">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
      </a>

      {nextProject ? (
        <a href={`/portfolio/${nextSlug}`} class="nav-card next glass">
          <span class="nav-hint">
            下一项目
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
          <span class="nav-title">{nextProject.data.title}</span>
        </a>
      ) : (
        <div class="nav-placeholder"></div>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .project-detail-page {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xxl);
    max-width: 860px;
  }

  /* Breadcrumb Navigation */
  .top-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--spacing-lg);
    font-size: 0.95rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: transform 0.2s ease;
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  .breadcrumb-separator {
    color: var(--color-text-secondary);
    opacity: 0.6;
  }

  .breadcrumb-current {
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Detail Hero */
  .detail-hero {
    margin-bottom: var(--spacing-xl);
  }

  .meta-pills {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--spacing-md);
  }

  .category-badge {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    background: rgba(0, 113, 227, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(0, 113, 227, 0.2);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #34c759;
  }

  .status-badge.completed .status-dot {
    background-color: #0071e3;
  }

  .status-badge.in-progress .status-dot {
    background-color: #ff9500;
  }

  .project-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    margin: 0 0 var(--spacing-md) 0;
    color: var(--color-text-main);
  }

  .project-tagline {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--spacing-lg) 0;
  }

  /* Hero Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 113, 227, 0.3);
  }

  .btn-primary:hover {
    background: #0077ed;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 113, 227, 0.4);
  }

  .btn-secondary {
    background: var(--color-bg-secondary);
    color: var(--color-text-main);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-bg-tertiary);
    border-color: rgba(0, 113, 227, 0.3);
    transform: translateY(-2px);
  }

  /* Info Bar */
  .info-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    gap: var(--spacing-lg);
  }

  @media (max-width: 640px) {
    .info-bar {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .info-item + .info-item {
    border-left: 1px solid var(--color-border);
    padding-left: var(--spacing-lg);
  }

  @media (max-width: 640px) {
    .info-item + .info-item {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--color-border);
      padding-top: var(--spacing-sm);
    }
  }

  .info-label {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .info-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  /* Cover Image Showcase */
  .cover-showcase-box {
    margin-bottom: var(--spacing-xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    background: var(--color-bg-secondary);
  }

  .detail-cover-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* Tech Section */
  .tech-section {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    margin-bottom: var(--spacing-xxl);
  }

  .tech-section-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-pill {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  /* Markdown Typography (.prose) */
  .project-prose {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-main);
    margin-bottom: var(--spacing-xxl);
  }

  .project-prose :global(h2) {
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 2.4em;
    margin-bottom: 0.8em;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.3em;
  }

  .project-prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.6em;
    margin-bottom: 0.6em;
    color: var(--color-text-main);
  }

  .project-prose :global(p) {
    margin-bottom: 1.4em;
    color: var(--color-text-main);
  }

  .project-prose :global(ul) {
    padding-left: 1.4em;
    margin-bottom: 1.4em;
    color: var(--color-text-secondary);
  }

  .project-prose :global(li) {
    margin-bottom: 0.5em;
  }

  .project-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5em 0;
  }

  .project-prose :global(blockquote) {
    margin: 1.5em 0;
    padding: var(--spacing-md) var(--spacing-lg);
    background: var(--color-bg-tertiary);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .project-prose :global(blockquote h3) {
    margin-top: 0;
    color: var(--color-accent);
  }

  .project-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.8em 0;
    font-size: 0.95rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .project-prose :global(th) {
    background: var(--color-bg-tertiary);
    color: var(--color-text-main);
    font-weight: 600;
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .project-prose :global(td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .project-prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .project-prose :global(tr:hover td) {
    background: rgba(0, 113, 227, 0.04);
  }

  .project-prose :global(code) {
    font-family: monospace;
    font-size: 0.88em;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
  }

  /* Bottom Navigation */
  .project-navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--spacing-md);
    align-items: center;
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 600px) {
    .project-navigation {
      grid-template-columns: 1fr;
    }
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .nav-card.next {
    text-align: right;
    align-items: flex-end;
  }

  .nav-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .nav-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .nav-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-all-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.08);
  }

  .nav-placeholder {
    visibility: hidden;
  }
</style>
