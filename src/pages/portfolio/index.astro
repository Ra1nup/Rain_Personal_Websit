---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/portfolio/ProjectCard.astro";

// Get all markdown projects from src/content/projects/*.md
const rawProjects = await getCollection("projects");

// Sort by order ascending, then by year
const projects = rawProjects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const CATEGORIES = [
  { id: "all", label: "All Projects" },
  { id: "Web", label: "Web Dev" },
  { id: "AIGC", label: "AIGC & AI" },
  { id: "Tools", label: "Tools" },
] as const;
---

<BaseLayout 
  title="Portfolio - Rainup | 探索我的精选项目与创意实践" 
  description="精选全栈开发、AIGC 智能创作工作流以及深度学习算法系统的独立项目集锦。"
>
  <div class="portfolio-page container">
    <!-- Header Section -->
    <header class="portfolio-header fade-in">
      <div class="header-badge">
        <span class="sparkle">✨</span> Selected Works & Creations
      </div>
      <h1 class="headline">
        Portfolio & Projects
      </h1>
      <p class="subheadline">
        从灵感构思到代码落地。这里汇集了我在全栈开发、AIGC 创意工具与深度学习领域的实践项目与复盘。
      </p>
    </header>

    <!-- Category Filter Tabs -->
    <div class="filter-wrapper fade-in" style="animation-delay: 0.1s;">
      <div class="filter-container glass" role="tablist">
        {CATEGORIES.map((category) => (
          <button 
            type="button" 
            class={`filter-tab ${category.id === 'all' ? 'active' : ''}`}
            data-category={category.id}
            role="tab"
            aria-selected={category.id === 'all' ? "true" : "false"}
          >
            {category.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <main class="projects-container fade-in" style="animation-delay: 0.2s;">
      <div class="projects-grid" id="projects-grid">
        {projects.map((project) => (
          <div class="grid-item" data-category={project.data.category}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>

      <!-- Empty Filter State -->
      <div class="empty-state hidden" id="empty-state">
        <div class="empty-icon">📁</div>
        <h3>暂无该分类下的项目</h3>
        <p>稍后会陆续添加更多精彩内容，敬请期待！</p>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  function setupProjectFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const items = document.querySelectorAll<HTMLElement>('.grid-item');
    const emptyState = document.getElementById('empty-state');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // Toggle active button
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const selectedCategory = tab.getAttribute('data-category');
        let visibleCount = 0;

        items.forEach((item) => {
          const itemCategory = item.getAttribute('data-category');
          if (selectedCategory === 'all' || itemCategory === selectedCategory) {
            item.style.display = 'block';
            item.style.animation = 'fadeInUp 0.35s ease forwards';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      });
    });
  }

  // Setup on initial load and view transitions if applicable
  setupProjectFilters();
  document.addEventListener('astro:page-load', setupProjectFilters);
</script>

<style>
  .portfolio-page {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xxl);
    min-height: calc(100vh - 140px);
  }

  /* Header Section */
  .portfolio-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--spacing-xl) auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    background: rgba(0, 113, 227, 0.08);
    border: 1px solid rgba(0, 113, 227, 0.2);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-xs);
  }

  .headline {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    background: linear-gradient(135deg, #1d1d1f 0%, #434344 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
  }

  :global(.dark) .headline {
    background: linear-gradient(135deg, #ffffff 0%, #a1a1a6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subheadline {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 650px;
  }

  /* Filter Tabs */
  .filter-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: var(--spacing-xl);
  }

  .filter-container {
    display: inline-flex;
    padding: 4px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    gap: 4px;
    overflow-x: auto;
    max-width: 100%;
    box-shadow: var(--shadow-sm);
  }

  .filter-tab {
    padding: 8px 18px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .filter-tab:hover {
    color: var(--color-text-main);
  }

  .filter-tab.active {
    color: #ffffff;
    background: var(--color-accent);
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 113, 227, 0.35);
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--spacing-lg);
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }

  .grid-item {
    display: block;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: var(--spacing-xxl) var(--spacing-lg);
    color: var(--color-text-secondary);
  }

  .empty-state.hidden {
    display: none;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }

  .empty-state h3 {
    color: var(--color-text-main);
    margin-bottom: var(--spacing-xs);
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
