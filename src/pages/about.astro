---

<BaseLayout title={pageTitle} description={pageDescription}>
    <div class="about-page">
        <!-- Page Header -->
        <header class="page-header fade-in">
            <div class="header-badge">
                <span class="pulse-dot"></span>
                <span>Get to Know Rain</span>
            </div>
            <h1 class="page-title">
                Hello, I'm <span class="gradient-text">Rain</span>
            </h1>
            <p class="page-subtitle">
                一个专业的逗比。食物勘探专员、深度睡眠研究员、夜间思考者、职场观察员、影视品鉴师、偶像鉴赏家、情绪感悟家、松弛生活家。梦想是和另一半（还没找到）一起环游世界。
            </p>
        </header>

        <!-- Bento Grid Hero Section -->
        <section class="bento-container fade-in delay-1">
            <!-- 1. Main Profile Card -->
            <div class="bento-card profile-main-card glass glow-effect">
                <div class="avatar-wrapper">
                    <div class="avatar-ring"></div>
                    <img
                        src="/qikang1.jpg"
                        alt="Qi Kang (Rain)"
                        class="avatar-img"
                    />
                </div>
                <div class="profile-content">
                    <div class="status-badge">
                        <span class="status-indicator"></span>
                        <span class="status-text">Available for Projects & Collaboration</span>
                    </div>
                    <h2 class="profile-name">
                        Rain <span class="profile-alias">(Qi Kang)</span>
                    </h2>
                    <p class="profile-role">
                        Computer Science Graduate & Full‑Stack / AIGC Explorer
                    </p>
                    <p class="profile-bio">
                        专注于全栈 Web 开发、AIGC 智能工具与深度学习应用实践。乐于和各路朋友交流探讨，保持持续学习。
                    </p>
                </div>
            </div>

            <!-- 2. Location & Quick Info Card -->
            <div class="bento-card info-card glass">
                <div class="card-icon-header">
                    <div class="icon-box">📍</div>
                    <span class="card-tag">Location</span>
                </div>
                <div class="info-body">
                    <h3 class="info-title">Beijing, China</h3>
                    <p class="info-desc">坐标通州，欢迎来找我玩</p>
                </div>
                <div class="micro-stats">
                    <div class="stat-pill">🎓 CS Major</div>
                    <div class="stat-pill">💻 Active Dev</div>
                </div>
            </div>

            <!-- 3. MBTI & Personality Card -->
            <div class="bento-card mbti-card glass">
                <div class="card-icon-header">
                    <div class="icon-box mbti-icon">⚡</div>
                    <span class="card-tag">Personality</span>
                </div>
                <div class="mbti-content">
                    <div class="mbti-badge">
                        <span class="mbti-type">ENFJ-A</span>
                        <span class="mbti-title">主人公 / The Protagonist</span>
                    </div>
                    <p class="mbti-desc">
                        富有同理心、热情并具备敏锐的创造力。善于发现生活与代码中的可能性，乐于与伙伴共同成长。
                    </p>
                    <div class="traits-group">
                        <span class="trait-tag">Empathetic</span>
                        <span class="trait-tag">Passionate</span>
                        <span class="trait-tag">Visionary</span>
                    </div>
                </div>
            </div>

            <!-- 4. Lifestyle & Passion Tags -->
            <div class="bento-card hobbies-card glass">
                <div class="card-icon-header">
                    <div class="icon-box">✨</div>
                    <span class="card-tag">Life Dimensions</span>
                </div>
                <h3 class="hobbies-title">When I'm Not Working</h3>
                <div class="hobby-chips">
                    <span class="hobby-chip"><span class="chip-emoji">💪</span> 力量训练 (Fitness)</span>
                    <span class="hobby-chip"><span class="chip-emoji">🏀</span> 热血篮球 (Basketball)</span>
                    <span class="hobby-chip"><span class="chip-emoji">🎮</span> 竞技开黑 (Gaming)</span>
                    <span class="hobby-chip"><span class="chip-emoji">🎧</span> 流行与电子乐 (Music)</span>
                    <span class="hobby-chip"><span class="chip-emoji">📚</span> 深度阅读 (Reading)</span>
                    <span class="hobby-chip"><span class="chip-emoji">🍜</span> 美食寻踪 (Foodie)</span>
                    <span class="hobby-chip"><span class="chip-emoji">🎬</span> 电影与番剧 (Cinema)</span>
                </div>
            </div>

            <!-- 5. Personal Philosophy Card -->
            <div class="bento-card philosophy-card glass">
                <div class="card-icon-header">
                    <div class="icon-box">💡</div>
                    <span class="card-tag">Philosophy</span>
                </div>
                <blockquote class="philosophy-quote">
                    "天天开心，身体健康最重要，专注自身，拒绝内耗！"
                </blockquote>
                <div class="quote-author">— Rain's Core Mindset</div>
            </div>
        </section>

        <!-- Passions & Favorites Showcase Section -->
        <section class="passions-section fade-in delay-2">
            <div class="section-header">
                <div class="section-badge">
                    <span>🌟</span>
                    <span>Curated Gallery</span>
                </div>
                <h2 class="section-title">
                    Passions & Favorites
                </h2>
                <p class="section-subtitle">
                    点击下方分类，探索我在游戏、球星、音乐、动漫影视与美食领域的挚爱收藏。
                </p>
            </div>

            <!-- Category Filter Tabs -->
            <div class="filter-tabs-container">
                <div class="filter-tabs glass" role="tablist" aria-label="Favorites Categories">
                    {categories.map((cat, idx) => (
                        <button
                            type="button"
                            class={`filter-tab ${idx === 0 ? 'active' : ''}`}
                            data-filter={cat.id}
                            role="tab"
                            aria-selected={idx === 0 ? 'true' : 'false'}
                        >
                            <span class="tab-icon">{cat.icon}</span>
                            <span class="tab-label">{cat.label}</span>
                            <span class="tab-count">{cat.count}</span>
                        </button>
                    ))}
                </div>
            </div>

            <!-- Passions Grid -->
            <div class="passions-grid" id="passions-grid">
                {passionItems.map((item) => (
                    <article
                        class="passion-card glass"
                        style={item.category === categories[0].id ? 'display: flex;' : 'display: none;'}
                        data-category={item.category}
                        data-id={item.id}
                    >
                        <div class="card-media-wrapper">
                            <img
                                src={item.image}
                                alt={item.title}
                                class="card-img"
                                loading="lazy"
                            />
                            <div class="media-overlay"></div>
                            <span class="card-category-badge">
                                <span class="badge-icon">{item.categoryIcon}</span>
                                <span>{item.categoryLabel}</span>
                            </span>
                            {item.tag && <span class="card-tag-badge">{item.tag}</span>}
                        </div>
                        <div class="card-info">
                            <h3 class="card-title">{item.title}</h3>
                            <p class="card-subtitle">{item.subtitle}</p>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Empty State for Filters -->
            <div class="empty-state hidden" id="filter-empty">
                <div class="empty-emoji">🔍</div>
                <h3>该分类下暂无内容</h3>
                <p>探索其他分类看看吧</p>
            </div>
        </section>
    </div>
</BaseLayout>

<script>
    function initPassionsFilter() {
        const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
        const cards = document.querySelectorAll<HTMLElement>('.passion-card');
        const emptyState = document.getElementById('filter-empty');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const targetFilter = tab.getAttribute('data-filter');
                if (!targetFilter) return;

                // Update active tab
                tabs.forEach(t => {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                tab.classList.add('active');
                tab.setAttribute('aria-selected', 'true');

                let visibleCount = 0;

                // Filter cards with smooth animation
                cards.forEach(card => {
                    const cardCategory = card.getAttribute('data-category');
                    if (cardCategory === targetFilter) {
                        card.style.display = 'flex';
                        card.classList.remove('card-fade-out');
                        card.classList.add('card-fade-in');
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                        card.classList.remove('card-fade-in');
                    }
                });

                // Handle empty state
                if (emptyState) {
                    if (visibleCount === 0) {
                        emptyState.classList.remove('hidden');
                    } else {
                        emptyState.classList.add('hidden');
                    }
                }
            });
        });
    }

    // Initialize on DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPassionsFilter);
    } else {
        initPassionsFilter();
    }
</script>

<style>
    .about-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 5rem 1.5rem 6rem;
        display: flex;
        flex-direction: column;
        gap: 4.5rem;
    }

    /* Base Glassmorphism */
    .glass {
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(0, 0, 0, 0.07);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.dark) .glass {
        background: rgba(24, 24, 27, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    }

    /* Animations */
    @keyframes fadeInScale {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .fade-in {
        opacity: 0;
        animation: fadeInScale 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .delay-1 { animation-delay: 0.15s; }
    .delay-2 { animation-delay: 0.3s; }

    /* Page Header */
    .page-header {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 1rem;
        border-radius: 9999px;
        background: rgba(0, 113, 227, 0.08);
        color: var(--color-accent, #0071e3);
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        border: 1px solid rgba(0, 113, 227, 0.2);
    }

    :global(.dark) .header-badge {
        background: rgba(41, 151, 255, 0.15);
        color: #5ac8fa;
        border-color: rgba(41, 151, 255, 0.3);
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #34c759;
        box-shadow: 0 0 8px rgba(52, 199, 89, 0.8);
        animation: pulseAnimation 2s infinite;
    }

    @keyframes pulseAnimation {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.3); opacity: 0.7; }
    }

    .page-title {
        font-size: clamp(2.5rem, 5vw, 3.75rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.03em;
        color: var(--color-text-main, #1d1d1f);
        margin: 0;
    }

    .gradient-text {
        background: linear-gradient(135deg, #0071e3 0%, #a855f7 50%, #ec4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    :global(.dark) .gradient-text {
        background: linear-gradient(135deg, #38bdf8 0%, #c084fc 50%, #f472b6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .page-subtitle {
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        color: var(--color-text-secondary, #86868b);
        line-height: 1.6;
        margin: 0;
    }

    /* Bento Grid System */
    .bento-container {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1.5rem;
    }

    .bento-card {
        border-radius: 28px;
        padding: 2rem;
        position: relative;
